{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vggt-metricphen.local/schemas/sample_manifest.schema.json",
  "title": "VGGT-MetricPhen sample manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "dataset_id",
    "site_id",
    "plot_id",
    "sequence_id",
    "rgb_paths",
    "data_level",
    "quality_grade",
    "split",
    "group_key",
    "license_id"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2200},
    "season": {"type": ["string", "null"]},
    "plot_id": {"type": "string", "minLength": 1},
    "plant_id": {"type": ["string", "null"]},
    "plant_date_id": {"type": ["string", "null"]},
    "sequence_id": {"type": "string", "minLength": 1},
    "duplicate_group_id": {"type": ["string", "null"]},
    "capture_date": {"type": ["string", "null"], "format": "date"},
    "crop": {"type": ["string", "null"]},
    "variety": {"type": ["string", "null"]},
    "growth_stage": {"type": ["string", "null"]},
    "sensor_platform": {"type": ["string", "null"]},
    "camera_id": {"type": ["string", "null"]},
    "rgb_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "intrinsics_path": {"type": ["string", "null"]},
    "extrinsics_path": {"type": ["string", "null"]},
    "distortion_path": {"type": ["string", "null"]},
    "pointcloud_path": {"type": ["string", "null"]},
    "ground_plane_path": {"type": ["string", "null"]},
    "scale_source": {"type": ["string", "null"]},
    "scale_value": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "scale_uncertainty": {"type": ["number", "null"], "minimum": 0},
    "ground_source": {"type": ["string", "null"]},
    "plant_height_cm": {"type": ["number", "null"], "minimum": 0},
    "canopy_width_row_cm": {"type": ["number", "null"], "minimum": 0},
    "canopy_width_cross_row_cm": {"type": ["number", "null"], "minimum": 0},
    "canopy_max_width_cm": {"type": ["number", "null"], "minimum": 0},
    "canopy_projected_area_cm2": {"type": ["number", "null"], "minimum": 0},
    "height_endpoint_policy": {"type": ["string", "null"]},
    "label_source": {"type": ["string", "null"]},
    "repeat_std": {"type": ["number", "null"], "minimum": 0},
    "data_level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
    "quality_grade": {"enum": ["QA", "QB", "QC", "QR"]},
    "defect_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "split": {"enum": ["train", "validation", "test", "calibration", "external_test", "unassigned"]},
    "group_key": {"type": "string", "minLength": 1},
    "license_id": {"type": "string", "minLength": 1},
    "source_archive_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
    "notes": {"type": ["string", "null"]}
  }
}

